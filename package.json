{
  "name": "mocktale",
  "private": true,
  "version": "0.0.0",
  "description": "Mock chat screenshots for AI assistants and messaging apps, made entirely in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/opendyslexic": "^5.3.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
